#! /usr/bin/make -f

include /usr/share/dpkg/pkg-info.mk

export PYBUILD_NAME=hatchling

%:
	dh $@ --buildsystem pybuild

execute_after_dh_auto_build:
	PYTHONPATH=src argparse-manpage --module hatchling.cli --function get_parser \
		--project-name hatchling --version $(DEB_VERSION_UPSTREAM) \
		--description "build backend used by Hatch" \
		--url https://hatch.pypa.io/ --output debian/hatchling.1

override_dh_auto_test:
	# Currently the only tests build packages, we can't run these
